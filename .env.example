# ─── .env.example ─────────────────────────────────────────────────────────────
# Copy this file to .env (in the project root) and replace the placeholder
# with your real OpenWeather API key.
#
# Get a FREE key at: https://openweathermap.org/api
# (Free tier includes: Current Weather, 5-day Forecast, Geocoding, Air Pollution)
#
# ⚠️  NEVER commit your real .env file to a public repository!
#     .env is already listed in .gitignore.

VITE_OPENWEATHER_API_KEY=your_api_key_here
